# 目标平台架构：针对 UTM/QEMU 的 ARM64 虚拟化
CONFIG_TARGET_armvirt=y
CONFIG_TARGET_armvirt_generic=y
CONFIG_TARGET_armvirt_generic_Default=y

# 编译 EFI 引导的 qcow2 镜像 (M4 Mac 完美适配)
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_QCOW2_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y

# 性能优化：强制开启 FPU 指令集，解决之前 1133ms 延迟问题
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -march=armv8-a+crypto+crc"
CONFIG_HAS_FPU=y

# 基础组件：集成证书、SSL 支持，避免 wget/curl 报错
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y

# PassWall 2 及其核心（直接编译进固件，避免手动安装依赖冲突）
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_sing-box=y
